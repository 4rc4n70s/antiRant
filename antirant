#!/usr/bin/env python3
"""antiRant: post-procesador de dictado para voxtype.

Lee la transcripción cruda por stdin, se la pasa a Gemini para que la
convierta en lo que realmente quisiste decir, y la escribe por stdout.

Regla de oro: ante cualquier error, devolver el texto original. voxtype
también cae al original si salimos con error o nos pasamos del timeout,
pero preferimos resolverlo acá y salir siempre con 0.
"""

import json
import os
import sys
import time
import tomllib
import urllib.error
import urllib.request
from pathlib import Path

APP_DIR = Path(__file__).resolve().parent
KEY_FILE = Path.home() / ".config/antirant/gemini_key"
LOG_FILE = Path.home() / ".local/state/antirant/log.jsonl"
API_URL = "https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent"


def load_config():
    with open(APP_DIR / "config.toml", "rb") as f:
        return tomllib.load(f)


def load_api_key():
    key = os.environ.get("GEMINI_API_KEY", "").strip()
    if key:
        return key
    return KEY_FILE.read_text().strip()


# Modo --json (lo usa tetsuHelper): además del texto limpio, una traducción
# al inglés para modelos que rinden mejor en inglés. Misma llamada a Gemini.
JSON_ADDENDUM = """

## Modo JSON
En lugar de sólo el texto, devolvé un objeto JSON con dos campos:
- "clean": el texto limpio, exactamente como lo devolverías normalmente (mismo idioma que el original).
- "en": una traducción fiel al inglés de "clean" (sin agregar ni sacar nada; nombres propios, apps y términos técnicos sin traducir).
"""


# Contexto opcional (--context FILE o ANTIRANT_CONTEXT): un Markdown con una
# sección "## Vocabulario" (el tetsu.md de tetsuHelper). Sólo se lee esa
# sección; el resto del archivo no sale nunca de la máquina.
VOCAB_SECTION = "vocabulario"
VOCAB_MAX_CHARS = 1500
VOCAB_ADDENDUM = """

## Vocabulario del usuario
Palabras y nombres que esta persona usa. Si la transcripción tiene algo que se parece a alguna (suena parecido, está mal escrito), escribila exactamente así. No agregues ninguna que no aparezca en lo dicho.
{words}
"""


def read_vocabulary(path):
    """Líneas de la sección Vocabulario de `path` ("" si no hay archivo o sección)."""
    try:
        text = Path(path).expanduser().read_text(encoding="utf-8")
    except (OSError, ValueError):
        return ""
    lines, inside, in_comment = [], False, False
    for line in text.splitlines():
        s = line.strip()
        # HTML comments (también de varias líneas) no son vocabulario.
        if in_comment:
            in_comment = "-->" not in s
            continue
        if s.startswith("<!--"):
            in_comment = "-->" not in s
            continue
        if s.startswith("#"):
            if s.startswith("## "):
                inside = s[3:].strip().lower().replace("á", "a") == VOCAB_SECTION
            continue
        if inside and s:
            lines.append("- " + (s.lstrip("-*• ").strip() if s[0] in "-*•" else s))
    return "\n".join(lines)[:VOCAB_MAX_CHARS]


def build_prompt(base, as_json=False, vocabulary=""):
    """System prompt: base + (modo JSON) + (vocabulario). Sin flags queda idéntico al de siempre."""
    prompt = base
    if as_json:
        prompt += JSON_ADDENDUM
    if vocabulary.strip():
        prompt += VOCAB_ADDENDUM.format(words=vocabulary.strip())
    return prompt


def context_path(argv):
    """Valor de --context FILE / --context=FILE, o ANTIRANT_CONTEXT, o None."""
    for i, a in enumerate(argv):
        if a == "--context" and i + 1 < len(argv):
            return argv[i + 1]
        if a.startswith("--context="):
            return a.split("=", 1)[1]
    return os.environ.get("ANTIRANT_CONTEXT", "").strip() or None


def rewrite(text, cfg, as_json=False, context=None):
    gemini = cfg["gemini"]
    prompt = build_prompt((APP_DIR / "prompt.md").read_text(), as_json,
                          read_vocabulary(context) if context else "")
    generation = {
        "temperature": gemini.get("temperature", 0.2),
        "thinkingConfig": {"thinkingLevel": gemini.get("thinking_level", "low")},
    }
    if as_json:
        generation["responseMimeType"] = "application/json"
        generation["responseSchema"] = {
            "type": "OBJECT",
            "properties": {"clean": {"type": "STRING"}, "en": {"type": "STRING"}},
            "required": ["clean", "en"],
        }
    body = {
        "systemInstruction": {"parts": [{"text": prompt}]},
        "contents": [{"role": "user", "parts": [{"text": text}]}],
        "generationConfig": generation,
    }
    req = urllib.request.Request(
        API_URL.format(model=gemini["model"]),
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json", "x-goog-api-key": load_api_key()},
    )
    with urllib.request.urlopen(req, timeout=gemini.get("timeout_secs", 4.5)) as resp:
        data = json.load(resp)
    parts = data["candidates"][0]["content"]["parts"]
    # Con thinking activado pueden venir partes de razonamiento marcadas
    # con "thought"; sólo nos interesa la respuesta.
    return "".join(p.get("text", "") for p in parts if not p.get("thought")).strip()


def looks_sane(original, result, cfg):
    if not result:
        return False
    # El modelo debería limpiar y condensar, no expandir. Si devuelve
    # bastante más texto que el original, probablemente inventó contenido.
    limit = len(original) * cfg["safety"].get("max_growth", 1.3) + 40
    return len(result) <= limit


def log(entry, cfg):
    if not cfg.get("log", {}).get("enabled", False):
        return
    try:
        LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
        with open(LOG_FILE, "a") as f:
            f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    except OSError:
        pass


def main():
    as_json = "--json" in sys.argv[1:]
    original = sys.stdin.read().strip()
    if not original:
        if as_json:
            sys.stdout.write(json.dumps({"clean": "", "en": None}))
        return

    output, english, status = original, None, "ok"
    started = time.monotonic()
    try:
        cfg = load_config()
        result = rewrite(original, cfg, as_json, context_path(sys.argv[1:]))
        if as_json:
            data = json.loads(result)
            result, candidate = str(data.get("clean", "")).strip(), data.get("en")
        if looks_sane(original, result, cfg):
            output = result
            if as_json and isinstance(candidate, str) and candidate.strip():
                english = candidate.strip()
        else:
            status = "rejected"
    except Exception as e:  # noqa: BLE001 - cualquier falla cae al original
        cfg = {}
        try:
            cfg = load_config()
        except Exception:
            pass
        status = f"error: {type(e).__name__}: {e}"

    if as_json:
        # Ante cualquier falla: el original y sin inglés (el que llama decide).
        sys.stdout.write(json.dumps({"clean": output, "en": english}, ensure_ascii=False))
    else:
        sys.stdout.write(output)
    log(
        {
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
            "ms": round((time.monotonic() - started) * 1000),
            "status": status,
            "in": original,
            "out": output,
            **({"en": english} if as_json else {}),
        },
        cfg,
    )


if __name__ == "__main__":
    main()
